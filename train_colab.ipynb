    {
      "cell_type": "markdown",
      "source": [
        "## 📚 Step 6: Download & Prepare TinyStories Dataset"
      ],
      "metadata": {
        "id": "step6"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from datasets import load_dataset\n",
        "from transformers import GPT2Tokenizer\n",
        "import torch\n",
        "from torch.utils.data import Dataset, DataLoader\n",
        "\n",
        "print(\"📚 Loading TinyStories dataset...\")\n",
        "\n",
        "# Load dataset\n",
        "dataset = load_dataset(\"roneneldan/TinyStories\", split=\"train\")\n",
        "print(f\"✅ Loaded {len(dataset)} stories\")\n",
        "\n",
        "# Load tokenizer\n",
        "tokenizer = GPT2Tokenizer.from_pretrained('gpt2')\n",
        "tokenizer.pad_token = tokenizer.eos_token\n",
        "print(\"✅ Tokenizer loaded\")\n",
        "\n",
        "# Create PyTorch Dataset\n",
        "class TinyStoriesDataset(Dataset):\n",
        "    def __init__(self, dataset, tokenizer, max_length=128):\n",
        "        self.dataset = dataset\n",
        "        self.tokenizer = tokenizer\n",
        "        self.max_length = max_length\n",
        "    \n",
        "    def __len__(self):\n",
        "        return len(self.dataset)\n",
        "    \n",
        "    def __getitem__(self, idx):\n",
        "        text = self.dataset[idx]['text']\n",
        "        \n",
        "        # Tokenize\n",
        "        encoded = self.tokenizer(\n",
        "            text,\n",
        "            max_length=self.max_length + 1,\n",
        "            padding='max_length',\n",
        "            truncation=True,\n",
        "            return_tensors='pt'\n",
        "        )\n",
        "        \n",
        "        input_ids = encoded['input_ids'].squeeze(0)\n",
        "        \n",
        "        # Input and target (shifted by 1)\n",
        "        x = input_ids[:-1]\n",
        "        y = input_ids[1:]\n",
        "        \n",
        "        return x, y\n",
        "\n",
        "# Split dataset\n",
        "train_size = int(0.95 * len(dataset))\n",
        "val_size = len(dataset) - train_size\n",
        "\n",
        "train_dataset = TinyStoriesDataset(dataset.select(range(train_size)), tokenizer)\n",
        "val_dataset = TinyStoriesDataset(dataset.select(range(train_size, len(dataset))), tokenizer)\n",
        "\n",
        "print(f\"✅ Train: {len(train_dataset)}, Val: {len(val_dataset)}\")\n",
        "print(\"✅ Dataset ready!\")"
      ],
      "metadata": {
        "id": "dataset"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "## 🎯 Step 7: Initialize Model & Optimizer"
      ],
      "metadata": {
        "id": "step7"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import sys\n",
        "sys.path.append(REPO_DIR)\n",
        "\n",
        "from slam3_pytorch import SLAM3Model, SLAM3Config, MetricsTracker\n",
        "import torch.optim as optim\n",
        "\n",
        "# Device setup\n",
        "device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
        "print(f\"🔧 Using device: {device}\")\n",
        "\n",
        "if torch.cuda.is_available():\n",
        "    print(f\"   GPU: {torch.cuda.get_device_name(0)}\")\n",
        "    print(f\"   Memory: {torch.cuda.get_device_properties(0).total_memory / 1e9:.2f} GB\")\n",
        "\n",
        "# Initialize model\n",
        "config = SLAM3Config()\n",
        "model = SLAM3Model(config)\n",
        "model = model.to(device)\n",
        "\n",
        "print(f\"\\n📊 Model Statistics:\")\n",
        "print(f\"   Parameters: {model.count_parameters():,}\")\n",
        "print(f\"   Embed Dim: {config.EMBED_DIM}\")\n",
        "print(f\"   Sequence Length: {config.SEQ_LEN}\")\n",
        "print(f\"   EF Cycles: {config.MAX_EF_CYCLES}\")\n",
        "print(f\"   Rotations: {config.NUM_ROTATIONS}\")\n",
        "\n",
        "# Optimizer with warmup\n",
        "optimizer = optim.AdamW(model.parameters(), lr=config.LEARNING_RATE, betas=(0.9, 0.95), weight_decay=0.1)\n",
        "\n",
        "# Learning rate scheduler\n",
        "from torch.optim.lr_scheduler import LambdaLR\n",
        "\n",
        "def lr_lambda(step):\n",
        "    if step < config.WARMUP_STEPS:\n",
        "        return step / config.WARMUP_STEPS\n",
        "    return max(0.1, 1.0 - (step - config.WARMUP_STEPS) / (config.MAX_STEPS - config.WARMUP_STEPS))\n",
        "\n",
        "scheduler = LambdaLR(optimizer, lr_lambda)\n",
        "\n",
        "# Metrics tracker\n",
        "metrics = MetricsTracker()\n",
        "\n",
        "# DataLoaders\n",
        "train_loader = DataLoader(train_dataset, batch_size=config.BATCH_SIZE, shuffle=True, num_workers=2)\n",
        "val_loader = DataLoader(val_dataset, batch_size=config.BATCH_SIZE, shuffle=False, num_workers=2)\n",
        "\n",
        "print(\"\\n✅ Model and optimizer initialized!\")"
      ],
      "metadata": {
        "id": "model_init"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "## 💾 Step 8: Checkpoint Management (GCS + Auto-Resume)"
      ],
      "metadata": {
        "id": "step8"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import json\n",
        "import tempfile\n",
        "from datetime import datetime\n",
        "\n",
        "class CheckpointManager:\n",
        "    def __init__(self, bucket, model, optimizer, scheduler, metrics):\n",
        "        self.bucket = bucket\n",
        "        self.model = model\n",
        "        self.optimizer = optimizer\n",
        "        self.scheduler = scheduler\n",
        "        self.metrics = metrics\n",
        "        self.checkpoint_dir = \"checkpoints\"\n",
        "    \n",
        "    def save_checkpoint(self, step, loss, is_best=False):\n",
        "        \"\"\"Save checkpoint to GCS\"\"\"\n",
        "        print(f\"\\n💾 Saving checkpoint at step {step}...\")\n",
        "        \n",
        "        checkpoint = {\n",
        "            'step': step,\n",
        "            'model_state_dict': model.state_dict(),\n",
        "            'optimizer_state_dict': optimizer.state_dict(),\n",
        "            'scheduler_state_dict': scheduler.state_dict(),\n",
        "            'loss': loss,\n",
        "            'metrics': metrics.metrics,\n",
        "            'timestamp': datetime.now().isoformat(),\n",
        "        }\n",
        "        \n",
        "        # Save to temporary file\n",
        "        with tempfile.NamedTemporaryFile(delete=False, suffix='.pt') as tmp:\n",
        "            torch.save(checkpoint, tmp.name)\n",
        "            tmp_path = tmp.name\n",
        "        \n",
        "        # Upload to GCS\n",
        "        blob_name = f\"{self.checkpoint_dir}/checkpoint_step_{step}.pt\"\n",
        "        blob = self.bucket.blob(blob_name)\n",
        "        blob.upload_from_filename(tmp_path)\n",
        "        \n",
        "        # Save as latest\n",
        "        latest_blob = self.bucket.blob(f\"{self.checkpoint_dir}/latest.pt\")\n",
        "        latest_blob.upload_from_filename(tmp_path)\n",
        "        \n",
        "        if is_best:\n",
        "            best_blob = self.bucket.blob(f\"{self.checkpoint_dir}/best.pt\")\n",
        "            best_blob.upload_from_filename(tmp_path)\n",
        "            print(\"   🏆 New best model saved!\")\n",
        "        \n",
        "        # Clean up\n",
        "        import os\n",
        "        os.unlink(tmp_path)\n",
        "        \n",
        "        print(f\"   ✅ Saved to: gs://{self.bucket.name}/{blob_name}\")\n",
        "        \n",
        "        # Also commit to GitHub\n",
        "        self.commit_to_github(step, loss)\n",
        "    \n",
        "    def load_latest_checkpoint(self):\n",
        "        \"\"\"Load latest checkpoint from GCS\"\"\"\n",
        "        try:\n",
        "            blob = self.bucket.blob(f\"{self.checkpoint_dir}/latest.pt\")\n",
        "            \n",
        "            if not blob.exists():\n",
        "                print(\"ℹ️  No checkpoint found, starting from scratch\")\n",
        "                return 0\n",
        "            \n",
        "            print(\"📥 Loading checkpoint from GCS...\")\n",
        "            \n",
        "            # Download to temp file\n",
        "            with tempfile.NamedTemporaryFile(delete=False, suffix='.pt') as tmp:\n",
        "                blob.download_to_filename(tmp.name)\n",
        "                tmp_path = tmp.name\n",
        "            \n",
        "            # Load checkpoint\n",
        "            checkpoint = torch.load(tmp_path, map_location=device)\n",
        "            \n",
        "            self.model.load_state_dict(checkpoint['model_state_dict'])\n",
        "            self.optimizer.load_state_dict(checkpoint['optimizer_state_dict'])\n",
        "            self.scheduler.load_state_dict(checkpoint['scheduler_state_dict'])\n",
        "            self.metrics.metrics = checkpoint['metrics']\n",
        "            \n",
        "            step = checkpoint['step']\n",
        "            loss = checkpoint['loss']\n",
        "            \n",
        "            # Clean up\n",
        "            import os\n",
        "            os.unlink(tmp_path)\n",
        "            \n",
        "            print(f\"   ✅ Resumed from step {step} (loss: {loss:.4f})\")\n",
        "            return step\n",
        "            \n",
        "        except Exception as e:\n",
        "            print(f\"⚠️  Error loading checkpoint: {e}\")\n",
        "            return 0\n",
        "    \n",
        "    def commit_to_github(self, step, loss):\n",
        "        \"\"\"Commit training progress to GitHub\"\"\"\n",
        "        try:\n",
        "            # Save training log\n",
        "            log_file = f\"{REPO_DIR}/training_log.json\"\n",
        "            log_data = {\n",
        "                'step': step,\n",
        "                'loss': float(loss),\n",
        "                'timestamp': datetime.now().isoformat(),\n",
        "                'gcs_checkpoint': f\"gs://{self.bucket.name}/{self.checkpoint_dir}/checkpoint_step_{step}.pt\"\n",
        "            }\n",
        "            \n",
        "            with open(log_file, 'w') as f:\n",
        "                json.dump(log_data, f, indent=2)\n",
        "            \n",
        "            # Commit and push\n",
        "            !cd {REPO_DIR} && git add training_log.json\n",
        "            !cd {REPO_DIR} && git commit -m \"Training checkpoint: step {step}, loss {loss:.4f}\"\n",
        "            !cd {REPO_DIR} && git push origin main 2>/dev/null || git push origin master 2>/dev/null\n",
        "            \n",
        "        except Exception as e:\n",
        "            print(f\"⚠️  GitHub commit failed: {e}\")\n",
        "\n",
        "# Initialize checkpoint manager\n",
        "checkpoint_manager = CheckpointManager(bucket, model, optimizer, scheduler, metrics)\n",
        "\n",
        "# Try to resume from latest checkpoint\n",
        "start_step = checkpoint_manager.load_latest_checkpoint()\n",
        "\n",
        "print(\"\\n✅ Checkpoint manager ready!\")"
      ],
      "metadata": {
        "id": "checkpoint"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "## 🏋️ Step 9: Training Loop with Auto-Save"
      ],
      "metadata": {
        "id": "step9"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import signal\n",
        "import sys\n",
        "\n",
        "# Global flag for graceful shutdown\n",
        "should_stop = False\n",
        "\n",
        "def signal_handler(sig, frame):\n",
        "    global should_stop\n",
        "    print('\\n\\n⚠️  Interrupt detected! Saving checkpoint...')\n",
        "    should_stop = True\n",
        "\n",
        "signal.signal(signal.SIGINT, signal_handler)\n",
        "\n",
        "def train_step(model, batch, config):\n",
        "    \"\"\"Single training step\"\"\"\n",
        "    tokens, targets = batch\n",
        "    tokens = tokens.to(device)\n",
        "    targets = targets.to(device)\n",
        "    \n",
        "    # Forward pass\n",
        "    logits = model(tokens, training=True)\n",
        "    \n",
        "    # Cross-entropy loss\n",
        "    logits_flat = logits.reshape(-1, config.VOCAB_SIZE)\n",
        "    targets_flat = targets.reshape(-1)\n",
        "    ce_loss = F.cross_entropy(logits_flat, targets_flat)\n",
        "    \n",
        "    # Auxiliary losses\n",
        "    lb_loss = model.encoder.get_load_balance_loss()\n",
        "    spec_loss = model.encoder.get_specialization_loss()\n",
        "    \n",
        "    # Total loss\n",
        "    total_loss = ce_loss + config.LOAD_BALANCE_WEIGHT * lb_loss + config.SPECIALIZATION_WEIGHT * spec_loss\n",
        "    \n",
        "    return total_loss, ce_loss, lb_loss, spec_loss\n",
        "\n",
        "def evaluate(model, val_loader, config, num_batches=50):\n",
        "    \"\"\"Evaluate model\"\"\"\n",
        "    model.eval()\n",
        "    total_loss = 0.0\n",
        "    \n",
        "    with torch.no_grad():\n",
        "        for i, batch in enumerate(val_loader):\n",
        "            if i >= num_batches:\n",
        "                break\n",
        "            \n",
        "            tokens, targets = batch\n",
        "            tokens = tokens.to(device)\n",
        "            targets = targets.to(device)\n",
        "            \n",
        "            logits = model(tokens, training=False)\n",
        "            logits_flat = logits.reshape(-1, config.VOCAB_SIZE)\n",
        "            targets_flat = targets.reshape(-1)\n",
        "            \n",
        "            loss = F.cross_entropy(logits_flat, targets_flat)\n",
        "            total_loss += loss.item()\n",
        "    \n",
        "    model.train()\n",
        "    return total_loss / num_batches\n",
        "\n",
        "# Training loop\n",
        "print(\"\\n\" + \"=\"*80)\n",
        "print(\"🏋️  STARTING TRAINING\")\n",
        "print(\"=\"*80)\n",
        "print(f\"Starting from step: {start_step}\")\n",
        "print(f\"Target steps: {config.MAX_STEPS}\")\n",
        "print(f\"Save every: {config.SAVE_EVERY} steps\")\n",
        "print(f\"Eval every: {config.EVAL_EVERY} steps\")\n",
        "print(\"\\nPress Ctrl+C anytime to save and stop gracefully\")\n",
        "print(\"=\"*80 + \"\\n\")\n",
        "\n",
        "if use_wandb:\n",
        "    wandb.init(project=\"slam3-training\", config=vars(config), resume=\"allow\")\n",
        "\n",
        "model.train()\n",
        "global_step = start_step\n",
        "best_val_loss = float('inf')\n",
        "train_iter = iter(train_loader)\n",
        "\n",
        "while global_step < config.MAX_STEPS and not should_stop:\n",
        "    try:\n",
        "        # Get batch\n",
        "        try:\n",
        "            batch = next(train_iter)\n",
        "        except StopIteration:\n",
        "            train_iter = iter(train_loader)\n",
        "            batch = next(train_iter)\n",
        "        \n",
        "        start_time = time.time()\n",
        "        \n",
        "        # Training step\n",
        "        optimizer.zero_grad()\n",
        "        total_loss, ce_loss, lb_loss, spec_loss = train_step(model, batch, config)\n",
        "        total_loss.backward()\n",
        "        \n",
        "        # Gradient clipping\n",
        "        torch.nn.utils.clip_grad_norm_(model.parameters(), config.GRAD_CLIP)\n",
        "        \n",
        "        optimizer.step()\n",
        "        scheduler.step()\n",
        "        \n",
        "        step_time = time.time() - start_time\n",
        "        \n",
        "        # Update metrics\n",
        "        metrics.update(\n",
        "            train_loss=total_loss.item(),\n",
        "            ce_loss=ce_loss.item(),\n",
        "            lb_loss=lb_loss.item(),\n",
        "            spec_loss=spec_loss.item(),\n",
        "            step_time=step_time,\n",
        "            learning_rate=scheduler.get_last_lr()[0]\n",
        "        )\n",
        "        \n",
        "        global_step += 1\n",
        "        \n",
        "        # Logging\n",
        "        if global_step % config.LOG_EVERY == 0:\n",
        "            stats = {\n",
        "                'loss': metrics.get_stats('train_loss', last_n=config.LOG_EVERY),\n",
        "                'ce': metrics.get_stats('ce_loss', last_n=config.LOG_EVERY),\n",
        "                'lr': scheduler.get_last_lr()[0],\n",
        "            }\n",
        "            \n",
        "            print(f\"Step {global_step}/{config.MAX_STEPS} | \"\n",
        "                  f\"Loss: {stats['loss']['mean']:.4f} | \"\n",
        "                  f\"CE: {stats['ce']['mean']:.4f} | \"\n",
        "                  f\"LR: {stats['lr']:.2e} | \"\n",
        "                  f\"{step_time*1000:.0f}ms/step\")\n",
        "            \n",
        "            if use_wandb:\n",
        "                wandb.log({\n",
        "                    'train/loss': stats['loss']['mean'],\n",
        "                    'train/ce_loss': stats['ce']['mean'],\n",
        "                    'train/learning_rate': stats['lr'],\n",
        "                    'step': global_step\n",
        "                })\n",
        "        \n",
        "        # Evaluation\n",
        "        if global_step % config.EVAL_EVERY == 0:\n",
        "            val_loss = evaluate(model, val_loader, config)\n",
        "            print(f\"\\n{'='*60}\")\n",
        "            print(f\"📊 Evaluation at step {global_step}\")\n",
        "            print(f\"   Val Loss: {val_loss:.4f}\")\n",
        "            print(f\"{'='*60}\\n\")\n",
        "            \n",
        "            if use_wandb:\n",
        "                wandb.log({'val/loss': val_loss, 'step': global_step})\n",
        "            \n",
        "            # Check if best\n",
        "            is_best = val_loss < best_val_loss\n",
        "            if is_best:\n",
        "                best_val_loss = val_loss\n",
        "        else:\n",
        "            is_best = False\n",
        "        \n",
        "        # Save checkpoint\n",
        "        if global_step % config.SAVE_EVERY == 0:\n",
        "            checkpoint_manager.save_checkpoint(global_step, total_loss.item(), is_best)\n",
        "    \n",
        "    except KeyboardInterrupt:\n",
        "        print(\"\\n⚠️  Training interrupted by user\")\n",
        "        should_stop = True\n",
        "    except Exception as e:\n",
        "        print(f\"\\n❌ Error during training: {e}\")\n",
        "        import traceback\n",
        "        traceback.print_exc()\n",
        "        should_stop = True\n",
        "\n",
        "# Final save\n",
        "print(\"\\n💾 Saving final checkpoint...\")\n",
        "checkpoint_manager.save_checkpoint(global_step, total_loss.item(), False)\n",
        "\n",
        "if use_wandb:\n",
        "    wandb.finish()\n",
        "\n",
        "print(\"\\n\" + \"=\"*80)\n",
        "print(\"✅ TRAINING COMPLETE!\")\n",
        "print(\"=\"*80)\n",
        "print(f\"Final step: {global_step}\")\n",
        "print(f\"Best val loss: {best_val_loss:.4f}\")\n",
        "print(f\"\\nCheckpoints saved to: gs://{BUCKET_NAME}/checkpoints/\")\n",
        "print(f\"Code pushed to: {REPO_URL}\")\n",
        "print(\"=\"*80)"
      ],
      "metadata": {
        "id": "training"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "## 🔮 Step 10: Test Generation"
      ],
      "metadata": {
        "id": "step10"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def generate_text(model, tokenizer, prompt, max_length=100, temperature=0.8, top_k=50):\n",
        "    \"\"\"Generate text from prompt\"\"\"\n",
        "    model.eval()\n",
        "    \n",
        "    # Encode prompt\n",
        "    input_ids = tokenizer.encode(prompt, return_tensors='pt').to(device)\n",
        "    \n",
        "    with torch.no_grad():\n",
        "        for _ in range(max_length):\n",
        "            # Get logits\n",
        "            if input_ids.shape[1] > config.SEQ_LEN:\n",
        "                # Truncate to seq_len\n",
        "                input_ids = input_ids[:, -config.SEQ_LEN:]\n",
        "            \n",
        "            logits = model(input_ids, training=False)\n",
        "            logits = logits[:, -1, :] / temperature\n",
        "            \n",
        "            # Top-k sampling\n",
        "            top_k_logits, top_k_indices = torch.topk(logits, top_k)\n",
        "            probs = F.softmax(top_k_logits, dim=-1)\n",
        "            next_token_idx = torch.multinomial(probs, 1)\n",
        "            next_token = top_k_indices.gather(-1, next_token_idx)\n",
        "            \n",
        "            # Append token\n",
        "            input_ids = torch.cat([input_ids, next_token], dim=1)\n",
        "            \n",
        "            # Stop on EOS\n",
        "            if next_token.item() == tokenizer.eos_token_id:\n",
        "                break\n",
        "    \n",
        "    # Decode\n",
        "    generated_text = tokenizer.decode(input_ids[0], skip_special_tokens=True)\n",
        "    return generated_text\n",
        "\n",
        "# Test generation\n",
        "print(\"\\n🔮 Testing text generation...\\n\")\n",
        "\n",
        "prompts = [\n",
        "    \"Once upon a time, there was a\",\n",
        "    \"The little girl went to the\",\n",
        "    \"In a magical forest, a\",\n",
        "]\n",
        "\n",
        "for prompt in prompts:\n",
        "    print(f\"Prompt: {prompt}\")\n",
        "    generated = generate_text(model, tokenizer, prompt, max_length=50)\n",
        "    print(f\"Generated: {generated}\")\n",
        "    print(\"-\" * 80)\n",
        "\n",
        "print(\"\\n✅ Generation test complete!\")"
      ],
      "metadata": {
        "id": "generation"
      },
      "execution_count": null,
      "outputs": []
    },
