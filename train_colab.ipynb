        "    list(bucket.list_blobs(max_results=1))\n",
        "    print(\"✅ Bucket access confirmed!\")\n",
        "except Exception as e:\n",
        "    print(f\"❌ Error accessing bucket: {e}\")\n",
        "\n",
        "# Save config\n",
        "os.environ['GCS_BUCKET'] = BUCKET_NAME\n",
        "os.environ['GCP_PROJECT'] = PROJECT_ID"
      ],
